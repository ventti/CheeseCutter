;;; ----------------------------------------------------------------------
;;; ultimate_host.acme
;;;
;;; Self-running host shim for C64 Ultimate (1541U / Ultimate64) playback
;;; and for the exported standalone .prg (Shift+F10). CheeseCutter's player
;;; is normally driven frame-by-frame by the host (the D side calls
;;; init/play/mplay in the emulated CPU). On real hardware nobody provides
;;; that tick, so this small, separate stub installs a VIC raster IRQ and
;;; dispatches to the *unmodified* player entry points. It also exposes a
;;; tiny control block in RAM that the host pokes over the REST writemem API
;;; to start/stop/keyjam.
;;;
;;; The whole live song image (player + data) lives at $0e00..~$f83d and
;;; deliberately uses RAM under BASIC/KERNAL ROM, so we run in all-RAM
;;; mode ($01 = $35: ROM banked out, IO still mapped for the SID at $d400)
;;; and take the hardware IRQ vector at $fffe (no KERNAL available).
;;;
;;; Display (black screen, light-grey text, lowercase/mixed charset):
;;;   row 0  CheeseCutter-Extended <ver>
;;;   row 1  Player: <playerID>
;;;   row 3  <title>
;;;   row 4  <author>
;;;   row 5  <release>
;;;   row 7  Time: MM:SS / $RR   (live, like CheeseCutter's Time/raster line)
;;; The border is flipped to dark green for the duration of each player call,
;;; so its height is a live raster-time meter; black otherwise.
;;;
;;; Symbols prepended by ct/build.d before assembly:
;;;   INITADDR, PLAYADDR, MPLAYADDR  - player jump table ($1000/$1003/$1006)
;;;   SUBNOTE, SUBMPLAY             - keyjam entry points (from song.offsets)
;;;   SHTRANSADDR                   - per-voice transpose table base
;;;   NEWKEYJAM                     - 1 if song.ver > 7 (use SUBNOTE/SUBMPLAY)
;;;   FRAMERATE                     - frames per second (50 PAL / 60 NTSC)
;;;   STARTMODE                     - initial ctrl_mode: 1 auto-play (standalone
;;;                                   .prg), 0 wait for the host's Play (--vice/--ultimate)
;;; The player is driven by a VIC raster IRQ on NUMSLOTS pre-defined lines per
;;; frame (one player call per line: PLAY on the first/lowest line, MPLAY on the
;;; rest). ct/build.d pokes the line table (numslots/rasline_lo/rasline_hi at
;;; $0816) with the lines evenly spaced and centred on the screen. This is a
;;; plain $d012 compare IRQ -- no cycle-stable raster.
;;; ----------------------------------------------------------------------

COL_BLACK	= 0
COL_WHITE	= 1		; info text (title/author/release), matches CheeseCutter
COL_GREEN	= 5		; status labels (and the raster-time meter border)
COL_DKGREY	= 11		; muted voice indicator
COL_GREY	= 12		; the app-version line
COL_LIGREEN	= 13		; status values (matches the editor's value color)
COL_LTGREY	= 15
COLRAM		= $d800 - $0400	; add to a screen address to get its colour-RAM cell

;;; Screen rows (the data block was shifted one row down; row 0 = app version).
SCR_ROW_FILE	= $0400 + 2*40	; .ct filename
SCR_ROW_PLAYER	= $0400 + 3*40
SCR_ROW_TITLE	= $0400 + 5*40
SCR_ROW_AUTHOR	= $0400 + 6*40
SCR_ROW_RELEASE	= $0400 + 7*40
SCR_ROW_TIME	= $0400 + 9*40
SCR_ROW_SID	= $0400 + 11*40	; detected SID model
SCR_ROW_VOICES	= $0400 + 12*40	; voice on/off
SCR_ROW_POS	= SCR_ROW_TIME + 21	; player position shares the Time row (4 cols after $RR)

;;; Screen cells of the live digits in the "Time: MM:SS / $RR" row.
SCR_ROW7	= SCR_ROW_TIME
CELL_MIN10	= SCR_ROW7 + 6
CELL_MIN1	= SCR_ROW7 + 7
CELL_SEC10	= SCR_ROW7 + 9
CELL_SEC1	= SCR_ROW7 + 10
CELL_RASH	= SCR_ROW7 + 15
CELL_RASL	= SCR_ROW7 + 16

;;; ----------------------------------------
;;; BASIC autostart: "10 SYS 2112". run_prg does a RUN, which jumps here.
;;; ----------------------------------------
		* = $0801
		!8 $0b,$08		; link to next BASIC line ($080b)
		!8 $0a,$00		; line number 10
		!8 $9e			; SYS token
		!8 $32,$31,$31,$32	; "2112"  -> $0840
		!8 $00			; end of line
		!8 $00,$00		; end of program

;;; ----------------------------------------
;;; Raster-line table at a fixed RAM address, poked by ct/build.d. The player
;;; is called once per raster IRQ on these NUMSLOTS lines (evenly spaced and
;;; centred on the screen). rasline_lo = $d012 value, rasline_hi = bit 8 (for
;;; lines > 255). 16 slots reserved (max multiplier).
;;; (The control/command block lives separately at $0bf0; see end of file.)
;;; ----------------------------------------
		* = $0816
numslots	!8 1		; number of player calls (raster lines) per frame
rasline_lo	!fill 16, 0	; low 8 bits of each raster compare line
rasline_hi	!fill 16, 0	; bit 8 of each raster compare line (0/1)

;;; ----------------------------------------
;;; Installer. Entered from BASIC (SYS 2112) with ROM still mapped.
;;; ----------------------------------------
		* = $0840
install
		sei
		lda #$35		; ROM out (BASIC+KERNAL), IO in
		sta $01

		jsr setup_screen

		lda #$7f
		sta $dc0d		; disable all CIA #1 IRQ sources
		sta $dd0d		; disable all CIA #2 IRQ/NMI sources
		lda $dc0d		; ack pending
		lda $dd0d

		lda #<irqhandler	; hardware IRQ vector (RAM, KERNAL is out)
		sta $fffe
		lda #>irqhandler
		sta $ffff
		lda #<nmihandler	; keep NMI harmless
		sta $fffa
		lda #>nmihandler
		sta $fffb

		lda #0
		sta rasidx		; start at slot 0 (the PLAY / frame-boundary line)
		sta fcnt
		sta secs
		sta mins
		sta rasval
		sta rasacc

		;; program the first raster compare line (slot 0)
		lda rasline_lo
		sta $d012
		lda $d011
		and #$7f		; clear raster bit 8; keep DEN/RSEL/YSCROLL
		ldy rasline_hi
		beq install_nohi
		ora #$80
install_nohi
		sta $d011
		lda #$01		; enable VIC raster IRQ
		sta $d01a
		lda #$ff		; ack any pending VIC IRQ
		sta $d019

		lda ctrl_subtune
		jsr INITADDR		; init the player (silent first frame)
		jsr detect_sid		; one-shot 6581/8580 probe -> ctrl_sidmodel (host reads it)
!if STARTMODE = 0 {
		jsr silence		; host-driven: stay quiet until REQ_RESTART (user Play)
}
		lda #STARTMODE
		sta ctrl_mode		; STARTMODE: 1 = auto-play (standalone .prg), 0 = wait
		cli
spin		jmp spin

nmihandler	rti

;;; ----------------------------------------
;;; Black screen + border, light-grey text (lowercase/mixed charset), then
;;; paint the static text rows.
;;; ----------------------------------------
setup_screen
		lda #$17		; screen $0400, char base $1800 (lowercase set)
		sta $d018
		lda #COL_BLACK
		sta $d020		; border
		sta $d021		; background
		ldx #0
clrscr		lda #$20		; space
		sta $0400,x
		sta $0500,x
		sta $0600,x
		sta $06e8,x		; covers up to $07e7
		lda #COL_WHITE		; base colour (info rows); paint_static recolours others
		sta $d800,x
		sta $d900,x
		sta $da00,x
		sta $dae8,x		; covers up to $dbe7
		inx
		bne clrscr

		ldx #39
ss0		lda sn_appver,x
		sta $0400,x		; row 0  (app version, grey)
		lda sn_file,x
		sta $0450,x		; row 2  (File: <name>)
		lda sn_player,x
		sta $0478,x		; row 3
		lda sn_title,x
		sta $04c8,x		; row 5
		lda sn_author,x
		sta $04f0,x		; row 6
		lda sn_release,x
		sta $0518,x		; row 7
		lda sn_status,x
		sta $0568,x		; row 9  (Time / raster, + Pos painted alongside)
		dex
		bpl ss0
		jsr paint_static	; recolour rows + paint the SID/Voices/Pos labels
		rts

;;; ----------------------------------------
;;; IRQ handler. A hardware IRQ only stacks PC+status, so preserve the
;;; registers ourselves. The border is green only while a player routine
;;; runs, giving a raster-time bar; the numeric raster value comes from the
;;; $d012 delta across the main play tick.
;;; ----------------------------------------
irqhandler
		pha
		txa
		pha
		tya
		pha
		lda #$ff		; ack VIC raster IRQ
		sta $d019

		lda rasidx		; refresh the status display once per frame (slot 0
		bne irq_nopaint		; only), not on every multispeed subtick
		jsr paint_dynamic	; SID model / voice on-off / position
irq_nopaint

		;; --- handle one-shot host request, if any ---
		lda ctrl_req
		bne hasreq
		jmp dispatch		; no request (dispatch is too far for a branch now)
hasreq		cmp #1
		beq do_restart
		cmp #2
		beq do_keyjam
		cmp #3
		beq do_stop
		jmp clrreq		; unknown -> just clear

do_restart
		;; apply the host's position seeds to the player's own variables
		ldx #5
rst_cpt		lda seed_tracklo,x
		sta SEEDTRACKLO,x
		dex
		bpl rst_cpt
		ldx #2
rst_cpnv	lda seed_newseq,x
		sta SEEDNEWSEQ,x
		lda seed_voice,x
		sta SEEDVOICE,x
		dex
		bpl rst_cpnv

		lda #0
		sta rasidx		; realign to slot 0 (PLAY) on the next line
		sta fcnt		; restart the playback clock
		sta secs
		sta mins
		lda seed_pos		; restart Pos from the row playback starts at
		sta pos_rows		; (host-supplied absolute row; wraps at seed_loopend)
		lda seed_pos+1
		sta pos_rows+1
		lda #$ff		; prev-speedcnt sentinel: the player's first
		sta pos_prev		; speedcnt is < $ff, so the initial count-down
					; isn't mistaken for a row reload (see pos_tick)
		lda ctrl_subtune
		jsr INITADDR
		lda #1
		sta ctrl_mode
		jmp clrreq

do_keyjam
		ldx #2			; apply the voice-on mask the host set for this note
kj_cpv		lda seed_voice,x
		sta SEEDVOICE,x
		dex
		bpl kj_cpv
!if NEWKEYJAM = 1 {
		ldx ctrl_kjvoice	; clear per-voice transpose (ver>8 semantics)
		lda #0
		sta SHTRANSADDR,x
}
		lda ctrl_kjnote
		ldx ctrl_kjvoice
		ldy ctrl_kjinstr
!if NEWKEYJAM = 1 {
		jsr SUBNOTE
} else {
		jsr $1009
}
		lda #2
		sta ctrl_mode
		jmp clrreq

do_stop
		jsr silence
		lda #0
		sta ctrl_mode
clrreq
		lda #0
		sta ctrl_req

		;; --- run the current mode for this tick ---
		;; One player call per raster IRQ. We fire on NUMSLOTS pre-defined
		;; lines per frame (rasline table, evenly spaced and centred): slot 0
		;; (the lowest line, reached first each frame) is the full PLAY tick;
		;; the others are sound-only MPLAY. rasidx tracks the current slot.
dispatch
		lda ctrl_mode
		beq nextline		; 0 = stopped (still advance to keep IRQs coming)
		cmp #2
		beq kjtick

		;; mode 1 = play
		lda rasidx
		bne pf_mplay
!if SHOW_RASTERTIME = 1 {
		lda rasacc		; frame boundary (slot 0): publish the previous
		sta rasval		; frame's summed raster time (all play+mplay)...
		lda #0
		sta rasacc		; ...then start accumulating the new frame
		jsr read_raster
		stx ras_start_hi
		sta ras_start
		lda #COL_GREEN
		sta $d020
}
		jsr PLAYADDR
!if SHOW_RASTERTIME = 1 {
		lda #COL_BLACK
		sta $d020
		jsr add_raster
}
		jsr apply_mute		; silence host-muted voices on the real SID
		jsr pos_tick		; advance the player-position counter (once/frame)
		jsr update_status	; repaint clock / raster meter once per frame
		jmp nextline
pf_mplay
!if SHOW_RASTERTIME = 1 {
		jsr read_raster		; mplay subframe: time it and add to the frame total
		stx ras_start_hi
		sta ras_start
		lda #COL_GREEN
		sta $d020
}
		jsr MPLAYADDR
!if SHOW_RASTERTIME = 1 {
		lda #COL_BLACK
		sta $d020
		jsr add_raster
}
		jsr apply_mute		; keep muted voices silenced across mplay subticks
		jmp nextline

kjtick
		ldx #0
!if SHOW_RASTERTIME = 1 {
		lda #COL_GREEN
		sta $d020
}
!if NEWKEYJAM = 1 {
		jsr SUBMPLAY
} else {
		jsr $100c
}
!if SHOW_RASTERTIME = 1 {
		lda #COL_BLACK
		sta $d020
}

		;; --- advance to the next slot and program its raster compare line ---
nextline
		inc rasidx
		lda rasidx
		cmp numslots
		bcc nl_set
		lda #0
		sta rasidx
nl_set
		ldx rasidx
		lda rasline_lo,x
		sta $d012
		lda $d011
		and #$7f		; keep DEN/RSEL/YSCROLL; clear raster bit 8
		ldy rasline_hi,x
		beq nl_nohi
		ora #$80
nl_nohi
		sta $d011

irqdone
		pla
		tay
		pla
		tax
		pla
		rti

;;; ----------------------------------------
;;; Advance the MM:SS clock (once per frame) and repaint the Time/raster row.
;;; ----------------------------------------
update_status
!if SHOW_TIMER = 1 {
		inc fcnt
		lda fcnt
		cmp #FRAMERATE
		bcc us_show
		lda #0
		sta fcnt
		inc secs
		lda secs
		cmp #60
		bcc us_show
		lda #0
		sta secs
		inc mins
		lda mins
		cmp #100
		bcc us_show
		lda #0
		sta mins
us_show
		lda mins
		jsr dec2
		stx CELL_MIN10
		sta CELL_MIN1
		lda secs
		jsr dec2
		stx CELL_SEC10
		sta CELL_SEC1
}
!if SHOW_RASTERTIME = 1 {
		lda rasval
		jsr hex2
		stx CELL_RASH
		sta CELL_RASL
}
		rts

;;; value A (0..99) -> X = tens screen char, A = ones screen char
dec2
		ldx #$ff
		sec
dec2l		inx
		sbc #10
		bcs dec2l
		adc #10
		ora #$30		; ones char
		pha
		txa
		ora #$30		; tens char
		tax
		pla
		rts

;;; (read_raster / add_raster relocated to free RAM below to keep this code
;;; region under $0b00 — they're jsr'd, so the address doesn't matter.)

;;; value A (0..255) -> X = high-nibble char, A = low-nibble char
hex2
		pha
		lsr
		lsr
		lsr
		lsr
		jsr hexd
		tax
		pla
		and #$0f
		jsr hexd
		rts
hexd		cmp #10
		bcc hexd0
		clc
		adc #$41-10		; A..F
		rts
hexd0		ora #$30		; 0..9
		rts

;;; ----------------------------------------
;;; Silence: master volume off and gate-off all three voices.
;;; ----------------------------------------
silence
		lda #0
		sta $d418
		sta $d404
		sta $d40b
		sta $d412
		rts

fcnt		!8 0		; frames within the current second
secs		!8 0
mins		!8 0
ras_start	!8 0		; raster line (low 8 bits) when the current call started
ras_start_hi	!8 0		; raster line bit 8 when the current call started
d_lo		!8 0		; scratch: lines used by the last call
rasval		!8 0		; published per-frame raster total (shown as $RR)
rasacc		!8 0		; raster lines accumulated so far this frame
rasidx		!8 0		; current slot 0..numslots-1 (which rasline we're on)

!if * > $0b00 { !error "CODE REGION OVERFLOW: ends at ", * }
;;; ----------------------------------------
;;; Text rows in C64 screen codes, filled by ct/build.d (40 bytes each).
;;; ----------------------------------------
		* = $0b00
sn_title	!fill 40, $20
sn_author	!fill 40, $20
sn_release	!fill 40, $20
sn_appver	!fill 40, $20
sn_player	!fill 40, $20
sn_status	!fill 40, $20

;;; ----------------------------------------
;;; Control / command block. The host pokes these bytes via
;;; POST /v1/machine:writemem?address=0bf0. Kept in free RAM above the text
;;; rows (and below the $0e00 live image) so the whole command — request +
;;; subtune + keyjam fields + position seeds — is one contiguous range and a
;;; restart/keyjam costs a single writemem (each request is ~150ms on real
;;; hardware, so request count is what matters). Keep in sync with the CTRL_*
;;; constants in src/audio/remote.d.
;;;
;;; The seed_* bytes are the playback position the host wants applied on the
;;; next restart (and the voice-on mask on keyjam): the shim copies them into
;;; the player's own variables (SEEDTRACKLO/SEEDNEWSEQ/SEEDVOICE, supplied by
;;; ct/build.d) when it services the request, because those player vars sit
;;; among runtime state we deliberately don't mirror byte-for-byte.
;;; ----------------------------------------
		* = $0bf0
ctrl_mode	!8 0		; mode the IRQ runs each tick: 0 stop, 1 play, 2 keyjam
ctrl_req	!8 0		; one-shot host request (cleared by the shim):
				;   1 = restart (apply seeds, jsr init, then play)
				;   2 = keyjam trigger (apply voice seed, jsr subnoteplay)
				;   3 = stop (silence)
ctrl_subtune	!8 0		; A value passed to init
ctrl_kjnote	!8 0		; keyjam note
ctrl_kjvoice	!8 0		; keyjam voice (0..2)
ctrl_kjinstr	!8 0		; keyjam instrument
seed_tracklo	!fill 6, 0	; -> TRACKLO (t1/t2/t3 lo, then hi)
seed_newseq	!fill 3, 0	; -> NEWSEQ (per voice)
seed_voice	!fill 3, 0	; -> VOICE (voice-on mask)
;; Player-position seeds (absolute note-rows, voice 0 = the canonical song
;; position, matching the editor's playback cursor). On restart the shim seeds
;; pos_rows with seed_pos and then wraps seed_loopend -> seed_loopstart, so the
;; on-target "Pos" starts at the row playback begins from and loops with the
;; song. The host recomputes them from the song each restart. lo then hi.
seed_pos	!fill 2, 0	; absolute start row (where playback begins)
seed_loopstart	!fill 2, 0	; absolute loop-back row (voice-0 wrap point)
seed_loopend	!8 $ff, $ff	; absolute endmark row; baked $ffff = no host -> never wraps
ctrl_sidmodel	!8 $ff		; detected SID: $ff=not yet, 0=6581, 1=8580 (host reads)

;;; ----------------------------------------
;;; SID model auto-detect (C=Hacking #20 "SID Type Auto-Detect"). The 6581 and
;;; 8580 differ on combined waveforms: drive voice 3 with triangle+sawtooth and
;;; the OSC3 readback ($d41b) is mostly zero with occasional bursts -- on the
;;; 8580 a burst reaches >=$80, on the 6581 it stays well below. Blank the screen
;;; (DEN=0) while sampling so bad lines don't steal cycles and perturb it. Runs
;;; once from install (IRQs already masked). Result -> ctrl_sidmodel: 0=6581 1=8580.
;;; ($d41b is the oscillator-3 waveform output, independent of gate/envelope.)
;;; Lives here in free RAM (above the control block, below the $0e00 image) so the
;;; routine never collides with the text rows the way it would after the code.
;;; ----------------------------------------
		* = $0c10
detect_sid
		lda $d011
		pha			; save screen control
		and #$ef		; DEN=0: blank screen -> no bad lines
		sta $d011
		lda #$20
		sta $d40e		; voice 3 freq = $2020
		sta $d40f
		lda #$30		; triangle+sawtooth combined (gate off, test off)
		sta $d412
		ldy #8			; sample 8*256 = 2048 times (~13 osc periods)
ds_outer	ldx #0
ds_loop		lda $d41b		; OSC3 high byte
		cmp #$80
		bcs ds_8580		; a burst >= $80 -> 8580
		inx
		bne ds_loop
		dey
		bne ds_outer
		lda #0			; no burst seen -> 6581
		beq ds_store		; (always; A=0)
ds_8580		lda #1
ds_store	sta ctrl_sidmodel
		pla
		sta $d011		; restore screen
		lda #0
		sta $d412		; leave voice 3 silent
		rts

;;; ----------------------------------------
;;; Mute: silence the voices the host has muted. The mirrored VOICE mask
;;; (SEEDVOICE) holds $19 for a muted voice (the player redirects its writes
;;; away), so we write $08 (TEST bit -> instant silence) to that voice's control
;;; register every tick after the player -- the on-device equivalent of the
;;; host-only muteSID(). Unmuted voices (mask 0/7/14) are left for the player.
;;; ----------------------------------------
apply_mute
		lda SEEDVOICE+0
		cmp #$19
		bne am_2
		lda #$08
		sta $d404
am_2		lda SEEDVOICE+1
		cmp #$19
		bne am_3
		lda #$08
		sta $d40b
am_3		lda SEEDVOICE+2
		cmp #$19
		bne am_done
		lda #$08
		sta $d412
am_done		rts

;;; Advance the position counter once per frame by watching the player itself
;;; advance a row, which is correct for BOTH constant tempo and funktempo. The
;;; player paces rows with its `speedcnt` byte: it reloads it (to the effective
;;; speed) at the start of each row, then decrements it once per frame down to 0.
;;; So speedcnt only ever *increases* on the reload frame — i.e. exactly once per
;;; row, regardless of whether the per-row count is fixed (constant speed) or
;;; alternates from the break-speed table (funktempo, where SPEED is 0/1 and a
;;; single fixed divider would drift). speedcnt is the byte right after the
;;; player's SPEED variable (speed, speedcnt, playspeed are consecutive), so it
;;; lives at SPEEDADDR+1. pos_prev holds last frame's value.
pos_tick
		ldx SPEEDADDR+1		; player's live speedcnt
		cpx pos_prev
		beq pt_done		; unchanged this frame
		bcc pt_store		; decreased: normal count-down, not a new row
		inc pos_rows		; increased: row reloaded -> count one row
		bne pt_wrapchk
		inc pos_rows+1
pt_wrapchk
		;; loop the display when the song loops: once pos_rows reaches the
		;; host-supplied endmark row, jump back to the wrap row (both voice 0).
		;; The baked default seed_loopend = $ffff (standalone export, no host) is
		;; never reached, so a non-hosted PRG just counts up without wrapping.
		lda pos_rows+1
		cmp seed_loopend+1
		bcc pt_store
		bne pt_wrap
		lda pos_rows
		cmp seed_loopend
		bcc pt_store
pt_wrap		lda seed_loopstart
		sta pos_rows
		lda seed_loopstart+1
		sta pos_rows+1
pt_store	stx pos_prev
pt_done		rts

;;; One-time at install: colour the rows (clrscr filled everything white). App
;;; version row grey; the four status rows green (their value cells get
;;; light-green from the per-frame painters). Then paint the static labels.
paint_static
		ldx #39
ps_l		lda #COL_GREY
		sta $d800,x			; row 0  app version (grey)
		lda #COL_GREEN
		sta $d800+9*40,x		; row 9  Time (+Pos) dark-green base; values recoloured
		sta $d800+11*40,x		; row 11 SID    (label; value recoloured by painter)
		sta $d800+12*40,x		; row 12 Voices
		dex
		bpl ps_l
		; File row (2) and Player row (3): dark-green label, bright-green value.
		ldx #39
ps_pl		lda #COL_LIGREEN
		cpx #6
		bcs ps_pl_f
		lda #COL_GREEN			; "File: " label = cols 0..5
ps_pl_f		sta $d800+2*40,x
		lda #COL_LIGREEN
		cpx #8
		bcs ps_pl_p
		lda #COL_GREEN			; "Player:" label = cols 0..7
ps_pl_p		sta $d800+3*40,x
		dex
		bpl ps_pl
		; static labels (explicit lowercase-charset screen codes)
		ldx #4
psl1		lda lbl_sid,x
		sta SCR_ROW_SID,x
		dex
		bpl psl1
		ldx #7
psl2		lda lbl_voices,x
		sta SCR_ROW_VOICES,x
		dex
		bpl psl2
		ldx #4
psl3		lda lbl_pos,x
		sta SCR_ROW_POS,x
		dex
		bpl psl3
		rts

;;; Per-frame value painters (called from update_status).
paint_dynamic
		jsr paint_sid_model
		jsr paint_voices
		jsr paint_pos
		jmp color_time_row

;;; Colour the time VALUE "MM:SS / $RR" (cols 6..16, including its ':' and '/') by
;;; play state: mid-grey stopped, bright green playing — like CheeseCutter. The
;;; "Time:" label (cols 0..5) stays paint_static's constant dark green, as does
;;; Pos (cols 21+, its own colours).
color_time_row
		ldy #COL_LIGREEN
		lda ctrl_mode
		cmp #1
		beq ctr_set
		ldy #COL_GREY
ctr_set		tya
		ldx #16
ctr_l		sta SCR_ROW_TIME+COLRAM,x
		dex
		cpx #5
		bne ctr_l		; colour cols 16..6; leave the "Time: " label (0..5)
		rts

;;; SID model digits at SCR_ROW_SID+5 ("6581"/"8580"); blank until detected.
paint_sid_model
		lda ctrl_sidmodel
		cmp #2
		bcc psm_show			; 0 or 1
		ldx #3				; not detected yet -> blank
psm_b		lda #$20
		sta SCR_ROW_SID+5,x
		dex
		bpl psm_b
		rts
psm_show	asl				; model*4 (0 or 4) -> source offset
		asl
		tax
		ldy #0
psm_c		lda sidtxt,x
		sta SCR_ROW_SID+5,y
		lda #COL_LIGREEN
		sta SCR_ROW_SID+5+COLRAM,y
		inx
		iny
		cpy #4
		bne psm_c
		rts

;;; Voice on/off digits '1' '2' '3' at SCR_ROW_VOICES+8/10/12: bright green when
;;; enabled, dark-grey when muted (VOICE mask == $19).
paint_voices
		ldx #0				; voice index 0..2
		ldy #0				; cell offset within the row (0,2,4 from +8)
pv_l		txa
		clc
		adc #$31
		sta SCR_ROW_VOICES+8,y		; '1'+i
		lda SEEDVOICE,x
		cmp #$19
		bne pv_on
		lda #COL_DKGREY			; muted
		bne pv_col			; (always)
pv_on		lda #COL_LIGREEN		; enabled -> bright green
pv_col		sta SCR_ROW_VOICES+8+COLRAM,y
		iny
		iny
		inx
		cpx #3
		bne pv_l
		rts

;;; Player position: 16-bit pos_rows -> 4 hex digits at SCR_ROW_POS+5 (matches
;;; CheeseCutter, which shows the position in hex). Reuses hex2.
paint_pos
		lda pos_rows+1
		jsr hex2			; X = high-nibble char, A = low-nibble char
		stx SCR_ROW_POS+5
		sta SCR_ROW_POS+6
		lda pos_rows
		jsr hex2
		stx SCR_ROW_POS+7
		sta SCR_ROW_POS+8
		ldx #3
pp_col		lda #COL_LIGREEN
		sta SCR_ROW_POS+5+COLRAM,x
		dex
		bpl pp_col
		rts

;;; ---- data (free RAM) ----
pos_prev	!8 $ff		; speedcnt seen last frame ($ff = no row yet; see pos_tick)
pos_rows	!8 0, 0
sidtxt		!8 $36,$35,$38,$31, $38,$35,$38,$30	; "6581" "8580" (digit screen codes)
lbl_sid		!8 $53,$49,$44,$3a,$20			; "SID: "
lbl_voices	!8 $56,$0f,$09,$03,$05,$13,$3a,$20	; "Voices: "
lbl_pos		!8 $50,$0f,$13,$3a,$20			; "Pos: "

;;; Raster-meter helpers, relocated here from the (full) code region.
read_raster
		ldx #0
		lda $d011
		and #$80
		beq rr_lo
		ldx #1
rr_lo		lda $d012
		rts
add_raster
		jsr read_raster
		sec
		sbc ras_start
		sta d_lo
		txa
		sbc ras_start_hi
		bpl ar_add
		lda d_lo
		clc
		adc #$38
		sta d_lo
ar_add
		clc
		lda rasacc
		adc d_lo
		sta rasacc
		rts

!if * > $0dd8 { !error "FREE-RAM OVERFLOW into sn_file ($0dd8): ends at ", * }
;;; Host-sent .ct filename (already prefixed "File: " by ct/build.d), painted to
;;; SCR_ROW_FILE by setup_screen. In free RAM (kept clear of the code above and
;;; the $0e00 image). Keep ULTIMATE_SN_FILE in ct/build.d in sync.
		* = $0dd8
sn_file		!fill 40, $20
